# Copy to .env and fill in as integrations come online. Everything is optional:
# the prototype runs fully offline with all of these left empty.

# --- ML pipeline ---
# Hugging Face token, only needed for gated checkpoints in samind_ml/train.py
HF_TOKEN=

# Experiment tracking (leave empty to disable)
WANDB_API_KEY=
WANDB_PROJECT=samind

# Where CI publishes trained .tflite artifacts (any http(s) or s3:// location)
MODEL_REGISTRY_URL=

# --- Android (mirrored in android/gradle.properties) ---
# Opt-in cloud chat backend for a future build flavor; the shipped prototype
# has no network permission and uses the on-device rule engine.
SAMIND_CHAT_API_BASE_URL=
SAMIND_CHAT_API_KEY=

# Endpoint for over-the-air model updates
SAMIND_MODEL_UPDATE_URL=

# Crash reporting DSN for internal test builds
SAMIND_SENTRY_DSN=
